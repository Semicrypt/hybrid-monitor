const express = require('express')
const cors = require('cors')
const axios = require('axios')
const sqlite3 = require('sqlite3').verbose()

const app = express()
const PORT = process.env.PORT || 5000

app.use(cors())
app.use(express.json())

// DATABASE
const db = new sqlite3.Database('./monitoring.db', (err) => {
  if (err) {
    console.error('Database error:', err.message)
  } else {
    console.log('Connected to SQLite database.')
  }
})

// CREATE TABLE
db.run(`
CREATE TABLE IF NOT EXISTS services (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  url TEXT NOT NULL,
  status TEXT DEFAULT 'UNKNOWN',
  response_time INTEGER DEFAULT 0,
  total_checks INTEGER DEFAULT 0,
  failed_checks INTEGER DEFAULT 0
)
`)

// FIX OLD DATABASE (safe migration)
db.run(`
ALTER TABLE services ADD COLUMN failed_checks INTEGER DEFAULT 0
`, (err) => {
  if (err && !err.message.includes('duplicate column')) {
    console.error(err.message)
  }
})

// CHECK SERVICE
async function checkService(service) {
  const start = Date.now()

  try {
    await axios.get(service.url)

    const responseTime = Date.now() - start

    db.run(`
      UPDATE services
      SET status = ?,
          response_time = ?,
          total_checks = total_checks + 1
      WHERE id = ?
    `, ['UP', responseTime, service.id])

  } catch (error) {
    db.run(`
      UPDATE services
      SET status = ?,
          failed_checks = failed_checks + 1,
          total_checks = total_checks + 1
      WHERE id = ?
    `, ['DOWN', service.id])
  }
}

// MONITOR LOOP
function monitorServices() {
  db.all(`SELECT * FROM services`, [], (err, rows) => {
    if (err) return console.error(err.message)

    rows.forEach(checkService)
  })
}

setInterval(monitorServices, 30000)

// ROUTES
app.get('/', (req, res) => {
  res.send('Hybrid Monitoring System Running')
})

app.post('/services', (req, res) => {
  const { name, url } = req.body

  if (!name || !url) {
    return res.status(400).json({ error: 'Name and URL required' })
  }

  db.run(`
    INSERT INTO services (name, url)
    VALUES (?, ?)
  `, [name, url], function (err) {
    if (err) return res.status(500).json({ error: err.message })

    res.json({ id: this.lastID, name, url })
  })
})

app.get('/dashboard', (req, res) => {
  db.all(`SELECT * FROM services`, [], (err, rows) => {
    if (err) return res.status(500).json({ error: err.message })

    res.json(rows)
  })
})

app.delete('/services/:id', (req, res) => {
  db.run(`DELETE FROM services WHERE id = ?`, [req.params.id], function (err) {
    if (err) return res.status(500).json({ error: err.message })

    res.json({ message: 'Service deleted' })
  })
})

app.listen(PORT, () => {
  console.log(`Server running on port ${PORT}`)
})
