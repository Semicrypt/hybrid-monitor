const express = require('express')
const cors = require('cors')
const axios = require('axios')
const { Pool } = require('pg')

const app = express()
const PORT = process.env.PORT || 5000

app.use(cors())
app.use(express.json())

// ================= POSTGRES DATABASE =================
const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
  ssl: { rejectUnauthorized: false }
})

// ================= CREATE TABLE =================
pool.query(`
CREATE TABLE IF NOT EXISTS services (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  url TEXT NOT NULL,
  status TEXT DEFAULT 'UNKNOWN',
  response_time INTEGER DEFAULT 0,
  total_checks INTEGER DEFAULT 0,
  failed_checks INTEGER DEFAULT 0
)
`).catch(err => console.error('DB Error:', err.message))

// ================= CHECK SERVICE =================
async function checkService(service) {
  const start = Date.now()

  try {
    await axios.get(service.url)

    const responseTime = Date.now() - start

    await pool.query(
      `UPDATE services
       SET status = $1,
           response_time = $2,
           total_checks = total_checks + 1
       WHERE id = $3`,
      ['UP', responseTime, service.id]
    )

  } catch (err) {
    await pool.query(
      `UPDATE services
       SET status = $1,
           failed_checks = failed_checks + 1,
           total_checks = total_checks + 1
       WHERE id = $2`,
      ['DOWN', service.id]
    )
  }
}

// ================= MONITOR LOOP =================
function monitorServices() {
  pool.query(`SELECT * FROM services`)
    .then(result => {
      result.rows.forEach(checkService)
    })
    .catch(err => console.error(err.message))
}

setInterval(monitorServices, 30000)

// ================= ROUTES =================

app.get('/', (req, res) => {
  res.send('Hybrid Monitoring System Running (PostgreSQL)')
})

// ADD SERVICE
app.post('/services', async (req, res) => {
  const { name, url } = req.body

  if (!name || !url) {
    return res.status(400).json({ error: 'Name and URL required' })
  }

  try {
    const result = await pool.query(
      `INSERT INTO services (name, url)
       VALUES ($1, $2)
       RETURNING *`,
      [name, url]
    )

    res.json(result.rows[0])
  } catch (err) {
    res.status(500).json({ error: err.message })
  }
})

// DASHBOARD
app.get('/dashboard', async (req, res) => {
  try {
    const result = await pool.query(`SELECT * FROM services`)
    res.json(result.rows)
  } catch (err) {
    res.status(500).json({ error: err.message })
  }
})

// DELETE SERVICE
app.delete('/services/:id', async (req, res) => {
  try {
    await pool.query(`DELETE FROM services WHERE id = $1`, [req.params.id])
    res.json({ message: 'Service deleted successfully' })
  } catch (err) {
    res.status(500).json({ error: err.message })
  }
})

// ================= START SERVER =================
app.listen(PORT, () => {
  console.log(`Server running on port ${PORT}`)
})
