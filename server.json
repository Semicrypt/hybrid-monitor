const express = require('express')
const cors = require('cors')

const app = express()
const PORT = process.env.PORT || 5000

app.use(cors())
app.use(express.json())

console.log("Server starting...")
console.log("PORT:", PORT)

// ================= IN-MEMORY DATABASE =================
let services = []

// ================= ROUTES =================

// HOME
app.get('/', (req, res) => {
  res.send('Hybrid Monitoring System Running (LOCAL MODE)')
})

// ADD SERVICE
app.post('/services', (req, res) => {
  const { name, url } = req.body

  if (!name || !url) {
    return res.status(400).json({ error: 'Name and URL required' })
  }

  const newService = {
    id: Date.now(),
    name,
    url,
    status: 'UNKNOWN',
    response_time: 0,
    total_checks: 0,
    failed_checks: 0
  }

  services.push(newService)

  res.json(newService)
})

// GET DASHBOARD
app.get('/dashboard', (req, res) => {
  res.json(services)
})

// DELETE SERVICE
app.delete('/services/:id', (req, res) => {
  services = services.filter(s => s.id != req.params.id)
  res.json({ message: 'Service deleted successfully' })
})

// SIMPLE CHECK FUNCTION (MOCK)
function checkServices() {
  services = services.map(service => {
    const isUp = Math.random() > 0.3 // fake status

    return {
      ...service,
      status: isUp ? 'UP' : 'DOWN',
      response_time: Math.floor(Math.random() * 300),
      total_checks: service.total_checks + 1,
      failed_checks: isUp
        ? service.failed_checks
        : service.failed_checks + 1
    }
  })
}

setInterval(checkServices, 10000)

// START SERVER
app.listen(PORT, () => {
  console.log(`Server running on port ${PORT}`)
})
